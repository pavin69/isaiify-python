# =============================================================================
# ISAIIFY MUSIC APP - ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# =============================================================================
# Copy this file to .env and replace placeholder values with your actual API credentials.
#
# IMPORTANT:
# - Never commit your real .env file or API keys to version control.
# - The .env file is automatically ignored by git.
# =============================================================================

# Server Port (optional, defaults to 5000 locally or provided by host/Render)
PORT=5000

# -----------------------------------------------------------------------------
# 1. Jamendo API Configuration (Creative Commons Music Catalog)
# -----------------------------------------------------------------------------
# Official Portal: https://developer.jamendo.com/
#
# How to get your Client ID:
# 1. Register a free developer account at https://developer.jamendo.com
# 2. Go to your Developer Dashboard and click "Create an application"
# 3. Choose the "Read Only" plan (covers search, streaming, and metadata)
# 4. Copy your Application Client ID and paste below.
#
# Note on Downloads:
# Jamendo allows free downloads only when the individual track artist has
# enabled "audiodownload_allowed" under Creative Commons terms.
JAMENDO_CLIENT_ID=your_jamendo_client_id_here

# -----------------------------------------------------------------------------
# 2. SoundCloud API Configuration (Official SoundCloud Streaming)
# -----------------------------------------------------------------------------
# Official Portal: https://developers.soundcloud.com/
#
# How to get your Client ID & Client Secret:
# 1. Sign in to your SoundCloud account and visit https://developers.soundcloud.com
# 2. Submit an application request to the SoundCloud Developer Program
# 3. Once approved, you will receive your Client ID and Client Secret
# 4. Paste them below.
#
# Note on Offline Downloads:
# SoundCloud Terms of Use strictly forbid downloading, ripping, or locally
# caching audio tracks via the API. All SoundCloud tracks in Isaiify are
# strictly streaming-only.
SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id_here
SOUNDCLOUD_CLIENT_SECRET=your_soundcloud_client_secret_here
